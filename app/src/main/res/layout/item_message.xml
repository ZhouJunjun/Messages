<?xml version="1.0" encoding="utf-8"?>
<!--
  One message row. Deliberately plain LinearLayouts only (1.0.7 spec):

  * Attachments live INSIDE the bubble now. They used to be a sibling sitting above it, which
    left an MMS picture floating outside its own bubble and - worse - made the bubble's height
    come out short, so the last lines of a rich MMS were clipped away.
  * The old RelativeLayout + ConstraintLayout chain measured every child with an `AT_MOST`
    budget derived from the views above it; once the attachment grew the budget shrank and the
    body was cut. Sequential wrap_content measuring has no such failure mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thread_message_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="40dp"
    android:foreground="@drawable/selector"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/thread_message_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="vertical">

        <!--
          The metadata row (1.1.05 spec): the per-message star toggle rides on this line, 10dp
          from the text - the same gap the metadata parts (SIM badge, sender number, timestamp)
          keep between themselves. A received message carries the star after the text, a sent
          one before it; only one slot is ever visible. The row is wrap_content, so the
          wrapper's gravity (set in the adapter) aligns it to the side the bubble grows from.
        -->
        <LinearLayout
            android:id="@+id/thread_message_metadata_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/thread_message_star_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:includeFontPadding="false"
                android:visibility="gone"
                app:emojiCompatEnabled="false"
                tools:text="⭐"
                tools:ignore="SelectableText" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/thread_message_metadata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/tiny_margin"
                android:drawablePadding="8dp"
                android:textSize="@dimen/smaller_text_size"
                tools:text="[1] 10086 26年1月2日 12:30" />

            <TextView
                android:id="@+id/thread_message_star_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:includeFontPadding="false"
                android:visibility="gone"
                app:emojiCompatEnabled="false"
                tools:text="⭐"
                tools:ignore="SelectableText" />
        </LinearLayout>

        <!--
          the bubble carries the background and holds the attachments, the body and the
          copyable-string row
        -->
        <LinearLayout
            android:id="@+id/thread_message_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/tiny_margin"
            android:background="@drawable/item_received_background"
            android:orientation="vertical"
            android:padding="@dimen/normal_margin">

            <RelativeLayout
                android:id="@+id/thread_message_attachments_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/thread_message_attachments_holder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:divider="@drawable/linear_layout_vertical_divider"
                    android:orientation="vertical"
                    android:showDividers="middle" />

                <ImageView
                    android:id="@+id/thread_message_play_outline"
                    android:layout_width="@dimen/play_outline_size"
                    android:layout_height="@dimen/play_outline_size"
                    android:layout_alignEnd="@id/thread_message_attachments_holder"
                    android:layout_alignBottom="@id/thread_message_attachments_holder"
                    android:layout_marginEnd="@dimen/medium_margin"
                    android:layout_marginBottom="@dimen/activity_margin"
                    android:src="@drawable/ic_play_outline_vector"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />
            </RelativeLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/thread_message_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:textSize="@dimen/normal_text_size"
                tools:drawableEndCompat="@drawable/scheduled_message_icon"
                tools:text="Message content" />

            <View
                android:id="@+id/thread_message_copyables_divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginTop="@dimen/small_margin"
                android:visibility="gone"
                tools:background="#33000000"
                tools:visibility="visible" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/thread_message_copyables"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone"
                tools:text="77342864300046 │ 8830-99"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors item_conversation.xml on purpose: the starred screen must look like the two
     conversation lists (avatar + title + 2 line snippet + date + copyable strings). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/starred_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tiny_margin"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/two_line_list_item_min_height"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin">

    <FrameLayout
        android:id="@+id/starred_avatar_holder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/starred_title">

        <ImageView
            android:id="@+id/starred_avatar_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:src="@mipmap/ic_launcher" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/starred_avatar_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_background"
            android:gravity="center"
            android:lineSpacingMultiplier="0.8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="中国&#10;移动"
            tools:visibility="visible" />
    </FrameLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/starred_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/activity_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/list_primary_text_size"
        app:layout_constraintBottom_toTopOf="@id/starred_body"
        app:layout_constraintEnd_toStartOf="@id/starred_star"
        app:layout_constraintStart_toEndOf="@id/starred_avatar_holder"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="中国移动" />

    <!--
      Star toggle, shown on search-result rows only (1.1.01 spec), parked 10dp to the right of the
      title. Tapping it stars / unstars the message without opening the conversation.

      🔴 Sizing (1.1.02 rework): the box is a fixed 24dp (a sane touch target) and 6dp of padding on
      every side leaves a 12dp glyph. It must NOT be tied to the title's height any more - the title
      is `wrap_content` inside a 16sp line box (~21dp tall) while its glyphs only stand ~11.5dp, so
      matching the line box made the star look far bigger than the text.
      The gap to the title is measured glyph-to-text, not box-to-box: marginStart 4dp + the 6dp
      padding = the 10dp the spec asks for.

      🔴 The row is a single chain: avatar -> title -> star -> date -> parent. Every view anchors to
      its left neighbour's end and its right neighbour's start; giving the star an end anchor
      (`starred_date`) is what keeps the chain closed - without it, title.end <-> star.start is a
      circular constraint and ConstraintLayout collapses the 0dp-wide title to zero width, which
      makes the title vanish and parks the star on top of the avatar.
    -->
    <ImageView
        android:id="@+id/starred_star"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/small_margin"
        android:clickable="true"
        android:focusable="true"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_star_outline_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/starred_title"
        app:layout_constraintEnd_toStartOf="@id/starred_date"
        app:layout_constraintStart_toEndOf="@id/starred_title"
        app:layout_constraintTop_toTopOf="@id/starred_title"
        tools:visibility="visible" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/starred_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activity_margin"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintBottom_toTopOf="@id/starred_copyables_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/starred_title"
        app:layout_constraintTop_toBottomOf="@id/starred_title"
        tools:text="您的验证码是 1234，请勿泄露。" />

    <View
        android:id="@+id/starred_copyables_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="@dimen/small_margin"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/starred_title"
        app:layout_constraintTop_toBottomOf="@id/starred_body" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/starred_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:textSize="@dimen/list_tertiary_text_size"
        app:layout_constraintBottom_toBottomOf="@id/starred_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/starred_star"
        app:layout_constraintTop_toTopOf="@id/starred_title"
        tools:text="2026/01/02 12:30" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/starred_copyables"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:textDirection="locale"
        android:textSize="@dimen/normal_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/starred_title"
        app:layout_constraintTop_toBottomOf="@id/starred_copyables_divider"
        tools:text="1234 │ 8830-99"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>
